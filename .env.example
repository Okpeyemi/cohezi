# Boîte Hostinger qui reçoit les inscriptions à la newsletter.
# L'option « Catch-all email » du domaine fait arriver toute adresse @cohezi.io ici.
# Sans SMTP_USER ni SMTP_PASSWORD, l'inscription est acceptée mais n'est transmise nulle part :
# un avertissement est écrit dans les journaux du serveur.

SMTP_USER=news@cohezi.io
SMTP_PASSWORD=

# Facultatif : les valeurs par défaut conviennent à Hostinger.
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# NEWSLETTER_TO=news@cohezi.io
# NEWSLETTER_FROM=news@cohezi.io
