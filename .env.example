# Inscription à la newsletter, via Brevo (double opt-in).
# Sans ces trois variables, la route /api/newsletter répond 503 : elle refuse
# franchement plutôt que de laisser croire à une inscription enregistrée.

BREVO_API_KEY=
# Identifiant de la liste « Newsletter Cohezi ».
BREVO_LIST_ID=4
# Identifiant du modèle double opt-in, créé depuis l'interface Brevo.
BREVO_DOI_TEMPLATE_ID=

# Facultatif : domaine utilisé pour construire l'URL de retour après confirmation.
# Par défaut https://www.cohezi.io — le domaine canonique, cohezi.io y redirige.
# NEXT_PUBLIC_SITE_URL=https://www.cohezi.io
